{
  "openapi": "3.1.0",
  "info": {
    "title": "Spo2 Desaturation Index API",
    "description": "Exploratory oxygen desaturation calculations and optional local supervisor endpoints.",
    "version": "3.1.0",
    "contact": {
      "name": "Dr. Abu Suraih Sakhri",
      "url": "https://github.com/abusuraihsakhri"
    }
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health and metadata check",
        "responses": {
          "200": {
            "description": "System optimal"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "JSON counters for supervisor operations",
        "responses": {
          "200": {
            "description": "JSON supervisor metrics"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate generic demonstration supervisor metrics",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "task_id": {
                    "type": "string"
                  },
                  "target_identifier": {
                    "type": "string"
                  },
                  "primary_metric": {
                    "type": "number"
                  },
                  "secondary_metric": {
                    "type": "number"
                  },
                  "status_descriptor": {
                    "type": "string"
                  },
                  "is_critical_flag": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "task_id",
                  "target_identifier",
                  "primary_metric"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Consensus dossier with HMAC signature"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Deterministic mock supervisor response",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "query": {
                    "type": "string"
                  }
                },
                "required": [
                  "query"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Supervisory response"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Inspect in-memory audit signatures and verify HMAC chain",
        "responses": {
          "200": {
            "description": "Cryptographic audit trail"
          }
        }
      }
    },
    "/api/odi": {
      "post": {
        "summary": "Analyze an evenly sampled SpO2 time series",
        "description": "Unvalidated rolling-baseline detector; data are not persisted by this endpoint.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "spo2_values"
                ],
                "properties": {
                  "spo2_values": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    "minItems": 1,
                    "maxItems": 150000
                  },
                  "sampling_interval_sec": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "default": 1
                  },
                  "threshold_pct": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 100,
                    "default": 3
                  },
                  "fio2": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 1
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "SpO2 metrics, ODI and detected events"
          },
          "422": {
            "description": "Invalid input"
          }
        }
      }
    }
  }
}
